---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { extractMeta, CATEGORY_LABELS } from '../../../lib/extract-meta';

export async function getStaticPaths() {
  const entries = await getCollection('canon');
  return entries.map((entry) => {
    const parts = entry.id.split('/');
    const category = parts[0];
    const slug = parts.slice(1).join('/');
    return {
      params: { category, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const meta = extractMeta(entry.body ?? '', entry.id);
const categoryParam = (Astro.params as { category: string }).category;
const categoryLabel = CATEGORY_LABELS[categoryParam] ?? categoryParam;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={meta.title} description={meta.byline ?? undefined}>
  <article class="shell prose">
    <div class="essay-category">
      <a href={`${base}/canon/`}>canon</a>
      <span aria-hidden="true"> · </span>
      <span>{categoryLabel}</span>
    </div>
    <Content />
    <div class="essay-end">
      <a href={`${base}/canon/`}>← 回到索引</a>
    </div>
  </article>
</BaseLayout>
